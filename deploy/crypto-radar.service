# Service systemd : collecte de données en continu (mode RESEARCH) sur
# un Raspberry Pi, avec redémarrage automatique.
# Guide complet : docs/22_raspberry_pi_data_collection.md
#
# Remplacer <user> par le compte du Pi. Le projet doit être dans
# /home/<user>/crypto_radar.
#
# Installer :
#   sudo cp deploy/crypto-radar.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now crypto-radar
#
# Vérifier :
#   sudo systemctl status crypto-radar
#   sudo journalctl -u crypto-radar -f
#
# Arrêter proprement (vide les tampons Parquet, comme Ctrl+C) :
#   sudo systemctl stop crypto-radar

[Unit]
Description=Crypto News Radar - data collection (RESEARCH mode)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<user>
WorkingDirectory=/home/<user>/crypto_radar
ExecStart=/home/<user>/crypto_radar/.venv/bin/python -m src.main
Restart=on-failure
RestartSec=10
# main.py gère SIGTERM proprement : on lui laisse 15 s avant SIGKILL.
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
