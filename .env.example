# =============================================================================
# .env.example — copy to .env and fill in. NEVER commit the real .env file.
# Section 64: no API key ever lives in code; nothing here is ever logged.
# =============================================================================

# --- Trading mode gate (section 65) ---
# Leave both false while in RESEARCH mode (the default and safest state).
PAPER_TRADING=false
LIVE_TRADING=false

# --- Hyperliquid (research / microstructure collection — read-only) ---
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_API_KEY=
HYPERLIQUID_API_SECRET=

# --- Kraken (execution, Phase 14+; also used read-only earlier for lead/lag research) ---
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
KRAKEN_WS_URL=wss://ws.kraken.com
KRAKEN_FUTURES_WS_URL=wss://futures.kraken.com/ws/v1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News APIs (fill in only the ones you actually enable in config/sources.yaml) ---
GOOGLE_NEWS_API_KEY=
TWITTER_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Storage ---
DATABASE_URL=sqlite:///data/processed/crypto_radar.db

# --- Misc ---
LOG_LEVEL=INFO
TZ=UTC
